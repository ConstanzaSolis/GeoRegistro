<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/mapViewGuardado"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="12dp"
        android:background="#FAF5FF"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvTituloRutaGuardada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ruta Guardada"
            android:textColor="#3B0082"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetalleCoordenadas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#4A148C"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnVolverHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="14dp"
        android:backgroundTint="#8A2BFF"
        android:text="Volver al Historial"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</RelativeLayout>